{#
/**
 * @file
 * CivicTheme Publication Card component (SDC/Experience Builder compatible).
 *
 * Props:
 * - theme: [string|null] Theme variation (light or dark).
 * - attributes: [string|null] Additional HTML attributes.
 * - modifier_class: [string|null] Additional CSS classes.
 * - image: [object|null] Card image (Experience Builder ref).
 *   - url: [string|null] Image URL.
 *   - alt: [string|null] Image alt text.
 * - file_name: [string|null] File name for download.
 * - file_url: [string|null] File download URL.
 * - file_ext: [string|null] File extension.
 * - file_size: [string|null] File size.
 * - link_url: [string|null] Link URL.
 * - link_is_new_window: [boolean|null] Whether to open the link in a new window.
 * - modifier_class: [string|null] Additional CSS classes.
 *
 * Slots:
 * - image_over: Image overlay content.
 * - content_top: Top content area.
 * - title: Card title text.
 * - content_middle: Middle content area.
 * - summary: Card summary.
 * - content_bottom: Bottom content area.
 *
 * Blocks:
 * - image_block
 * - image_over_block
 * - content_top_block
 * - title_block
 * - content_middle_block
 * - summary_block
 * - link_block
 * - content_bottom_block
 */
#}

{% set with_image = image.src is not empty %}
{% set with_image_class = with_image ? 'ct-publication-card--with-image' : '' %}
{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set modifier_class = '%s %s %s'|format(theme_class, with_image_class, modifier_class|default('')) %}

{% if title is not empty %}
  <div class="ct-publication-card {{ modifier_class -}}" {% if attributes is not empty %}{{- attributes|raw -}}{% endif %}>
    {% if with_image or image_over is not empty %}
        <div class="ct-publication-card__image">
          {% include 'civictheme_xb:image' with {
            theme: theme,
          image: image,
          } only %}
            {% if image_over is not empty %}
              <div class="ct-publication-card__image__over">
                {{ image_over }}
              </div>
            {% endif %}
        </div>
      {% endif %}
    <div class="ct-publication-card__content">
        {% if content_top is not empty %}
          <div class="ct-publication-card__content-top">
          {{ content_top }}
          </div>
        {% endif %}
        {% if title is not empty %}
          {% set title_content %}
          {% if file_url is not empty %}
            {% include 'civictheme_xb:link' with {
              theme: theme,
              text: title,
              url: file_url,
              icon: 'download',
              icon_group_disabled: true,
              modifier_class: 'ct-publication-card__title__link',
            } only %}
          {% else %}
            {{ title }}
          {% endif %}
          {% endset %}
          {% include 'civictheme_xb:heading' with {
            content: title_content,
            level: 4,
            theme: theme,
            modifier_class: 'ct-publication-card__title',
          } only %}
        {% endif %}
        {% if content_middle is not empty %}
        <div class="ct-publication-card__content-middle">
          {{ content_middle }}
          </div>
        {% endif %}
        {% if summary is not empty %}
          {% include 'civictheme_xb:paragraph' with {
            theme: theme,
            content: summary,
            allow_html: true,
            modifier_class: 'ct-publication-card__summary',
          } only %}
        {% endif %}
      {% if file_name is not empty and file_url is not empty %}
        {% set extension = '' %}
        {% if file_ext is not empty and file_size is not empty %}
          {% set extension = ' <span class="ct-publication-card__link__extension">(%s, %s)</span>'|format(file_ext, file_size) %}
        {% elseif file_ext is not empty or file_size is not empty %}
          {% set extension = ' <span class="ct-publication-card__link__extension">(%s)</span>'|format(file_ext|default(file_size)) %}
        {% endif %}
        {% include 'civictheme_xb:link' with {
          theme: theme,
          text: file_name ~ extension,
          title: 'Download %s'|format(file_name),
          url: file_url,
          modifier_class: 'ct-publication-card__link',
        } only %}
      {% endif %}
        {% if content_bottom is not empty %}
          <div class="ct-publication-card__content-bottom">
          {{ content_bottom }}
          </div>
        {% endif %}
    </div>
  </div>
{% endif %}
